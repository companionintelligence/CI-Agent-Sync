{
  "servers": {
    "microsoft/markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp@0.0.1a4"]
    },
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--registry",
        "https://registry.npmjs.org",
        "chrome-devtools-mcp@1.12.0"
      ]
    },
    "microsoft/playwright-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "@playwright/mcp@0.0.83"]
    },
    "io.github.github/github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "huggingface/hf-mcp-server": {
      "type": "http",
      "url": "https://huggingface.co/mcp?login"
    },
    "companion-memory": {
      "type": "http",
      "url": "${env:COMPANION_HUB_BASE_URL}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:COMPANION_HUB_API_KEY}"
      }
    },
    "companionintelligence/ci-common": {
      "type": "stdio",
      "command": "node",
      "args": ["${env:CI_COMMON_ROOT}/apps/dashboard/mcp.mjs", "--start"],
      "env": {
        "CI_WORKSPACE": "${env:CI_ROOT}"
      }
    },
    "companionintelligence/ci-engineering": {
      "type": "stdio",
      "command": "node",
      "args": ["${env:CI_ENGINEERING_ROOT}/tools/mcp-server.mjs", "--start"],
      "env": {
        "CI_WORKSPACE": "${env:CI_ROOT}"
      }
    },
    "metricool": {
      "type": "http",
      "url": "https://ai.metricool.com/mcp"
    }
  }
}
