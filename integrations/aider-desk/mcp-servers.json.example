{
  "mcpServers": {
    "ci-common": {
      "command": "node",
      "args": ["${CI_COMMON_ROOT}/apps/dashboard/mcp.mjs", "--start"],
      "env": {"CI_WORKSPACE": "${CI_ROOT}"}
    },
    "ci-engineering": {
      "command": "node",
      "args": ["${CI_ENGINEERING_ROOT}/tools/mcp-server.mjs", "--start"],
      "env": {"CI_WORKSPACE": "${CI_ROOT}"}
    },
    "metricool": {
      "url": "https://ai.metricool.com/mcp"
    },
    "companion-hub": {
      "url": "${COMPANION_HUB_BASE_URL}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${COMPANION_HUB_API_KEY}"
      }
    },
    "companion-memory": {
      "url": "${COMPANION_MEMORY_BASE_URL}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${COMPANION_MEMORY_API_KEY}"
      }
    }
  }
}
