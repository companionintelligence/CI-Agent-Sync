# Copy to local/kvm.env (gitignored) and run clients with:
#   op run --env-file local/kvm.env -- opencode
# Values are op:// references, so no key is written to disk. Each item holds the
# API key shown on the device's MCP page (NanoKVM) or the PiKVM admin password.
NANOKVM_CORE_4_KVM_API_KEY=op://Agent Configs/agent-configs-kvm-core-4-kvm/credential
NANOKVM_CORE_14_KVM_API_KEY=op://Agent Configs/agent-configs-kvm-core-14-kvm/credential
NANOKVM_CORE_17_KVM_API_KEY=op://Agent Configs/agent-configs-kvm-core-17-kvm/credential
NANOKVM_BETA_MS_A2_KVM_API_KEY=op://Agent Configs/agent-configs-kvm-beta-ms-a2-kvm/credential
PIKVM_BETA_KVM_1_PASSWORD=op://Agent Configs/agent-configs-kvm-beta-kvm-1/credential
PIKVM_BETA_KVM_2_PASSWORD=op://Agent Configs/agent-configs-kvm-beta-kvm-2/credential
