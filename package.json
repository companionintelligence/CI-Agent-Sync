{
  "name": "@companionintelligence/agent-sync",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Portable Companion Intelligence agent control plane",
  "keywords": [
    "agent",
    "mcp",
    "control-plane",
    "companion-intelligence"
  ],
  "homepage": "https://github.com/companionintelligence/CI-Agent-Sync#readme",
  "bugs": {
    "url": "https://github.com/companionintelligence/CI-Agent-Sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/companionintelligence/CI-Agent-Sync.git"
  },
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-sync": "dist/cli.js",
    "agentctl": "dist/cli.js",
    "agent-atlas": "dist/atlas-bin.js"
  },
  "files": [
    "dist/",
    "bin/",
    "scripts/",
    "web/",
    "agents/",
    "context/",
    "docs/",
    "integrations/",
    "profiles/",
    "providers/",
    "repos/",
    "sync/",
    "workflows/",
    ".agent-configs/",
    "!agents/**/*.redacted.*",
    "!agents/vscode/extensions.txt",
    "!scripts/test.rb",
    "!scripts/test_*.rb",
    "!scripts/verify.sh",
    "!web/app.ts",
    "!profiles/machines/local.yaml",
    "!sync/targets.yaml",
    "!**/.env",
    "!**/.env.*",
    "!**/auth.json",
    "!**/.credentials.json",
    "!**/*token*.json",
    "!**/*secret*.json",
    "!web/assets/agent-atlas-logo.png",
    "!**/node_modules/",
    "!**/local/",
    "!**/work/",
    "!**/state/raw/",
    "!**/reports/raw/",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.p12",
    "!**/*.pfx",
    "!**/*.jks",
    "!**/*.keystore",
    "!**/*.p8",
    "!**/*.ppk",
    "!**/*.gpg",
    "!**/*.kdbx",
    "!**/id_rsa*",
    "!**/id_dsa*",
    "!**/id_ecdsa*",
    "!**/id_ed25519*",
    "!**/known_hosts",
    "!**/authorized_keys",
    "!**/.netrc",
    "!**/_netrc",
    "!**/.git-credentials",
    "!**/.pypirc",
    "!**/.htpasswd",
    "!**/.pgpass",
    "!**/credentials*",
    "!**/service-account*",
    "!**/service_account*",
    "!**/token.txt",
    "!**/api-key*",
    "!**/apikey*",
    "!**/password*",
    "!**/secret.*",
    "!**/secrets.*",
    "!**/env",
    "!**/*.env",
    "!**/.envrc",
    "!**/*.sqlite",
    "!**/*.sqlite3",
    "!**/*.db",
    "!**/*.log",
    "!**/*.bak",
    "providers/.env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --experimental-strip-types --no-warnings src/cli.ts check",
    "dev": "node --experimental-strip-types --no-warnings src/cli.ts atlas --open",
    "start": "node --experimental-strip-types --no-warnings src/cli.ts atlas",
    "build": "tsc --project tsconfig.json && esbuild web/app.ts --bundle --format=iife --target=es2020 --outfile=web/app.js",
    "build:cli": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "prepack": "npm run build:cli",
    "prepublishOnly": "node .github/scripts/refuse-local-publish.mjs",
    "test": "node --experimental-strip-types --no-warnings src/test.ts"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
