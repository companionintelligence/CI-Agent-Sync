{
  "env": {
    "ANDROID_MCP_TOKEN_BEAM_PRO": "<redacted>",
    "ANDROID_MCP_TOKEN_BEAM_PRO_1": "<redacted>",
    "ANDROID_MCP_TOKEN_TAB_S8_ULTRA": "<redacted>",
    "ANDROID_MCP_TOKEN_TAB_S9_ULTRA": "<redacted>"
  },
  "permissions": {
    "allow": [
      "Bash(npx vite:*)",
      "Bash(rsvg-convert -w 180 -h 180 apple-touch-icon.svg)",
      "Bash(rsvg-convert -w 192 -h 192 icon.svg)",
      "Bash(rsvg-convert -w 512 -h 512 icon.svg)",
      "Bash(rsvg-convert -w 512 -h 512 maskable-icon.svg)",
      "Bash(ls -la *.png)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",
      "Bash(npm update:*)",
      "Bash(git -C /Users/<user>/devel/ci/CI-Earth-2 log --oneline -3)",
      "Bash(git -C /Users/<user>/devel/ci/CI-Earth-2 status -sb)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_console_messages",
      "Bash(npm test*)",
      "mcp__Claude_Browser__get_page_text",
      "Bash(git ls-tree *)",
      "mcp__Claude_Browser__preview_logs",
      "Bash(pnpm vitest run *)",
      "mcp__Claude_Browser__read_network_requests"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<user>/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "Proactive",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(deno task check)",
      "Bash(deno task test)",
      "Bash(tailscale status --json)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(gh issue create:*)",
      "Bash(scripts/factory/factory.sh create:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ],
    "environment": [
      "<redacted: describe your own environment here>"
    ]
  },
  "switchModelsOnFlag": true
}
