{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6-35b-64k:latest": {
          "name": "Qwen 3.6 35B 64K"
        },
        "qwen3.6:35b": {
          "name": "Qwen 3.6 35B"
        },
        "qwen3.6:27b": {
          "name": "Qwen 3.6 27B"
        },
        "nemotron3:33b": {
          "name": "Nemotron 3 33B"
        },
        "gemma4:31b": {
          "name": "Gemma 4 31B"
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B"
        },
        "qwen3-vl:4b": {
          "name": "Qwen 3 VL 4B"
        },
        "qwen2.5:0.5b": {
          "name": "Qwen 2.5 0.5B"
        }
      }
    }
  },
  "model": "ollama/qwen3.6-35b-64k:latest",
  "small_model": "ollama/qwen3.6-35b-64k:latest",
  "mcp": {
    "servers": {
      "ci-common": {
        "type": "local",
        "command": [
          "node",
          "/Users/liam/devel/ci/CI-Common/apps/dashboard/mcp.mjs",
          "--start"
        ],
        "environment": {
          "CI_WORKSPACE": "/Users/liam/devel/ci"
        }
      },
      "ci-engineering": {
        "type": "local",
        "command": [
          "node",
          "/Users/liam/devel/ci/0-HUB/CI-Engineering/tools/mcp-server.mjs",
          "--start"
        ],
        "environment": {
          "CI_WORKSPACE": "/Users/liam/devel/ci"
        }
      },
      "metricool": {
        "type": "remote",
        "url": "https://ai.metricool.com/mcp"
      }
    }
  }
}
