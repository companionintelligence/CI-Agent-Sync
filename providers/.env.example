# Optional non-secret environment overrides. Do not put API keys here.
AGENT_CONFIGS_SECRET_BACKEND=1password
AGENT_CONFIGS_ALLOW_NATIVE_FALLBACK=true
AGENT_CONFIGS_OP_VAULT=Agent Configs
# OP_ACCOUNT=your-account.1password.com
# OP_LOAD_DESKTOP_APP_SETTINGS=true
OLLAMA_HOST=http://127.0.0.1:11434
OMLX_BASE_URL=http://127.0.0.1:8000/v1
# Set this to the reachable appliance origin; the MCP recipe appends /api/mcp.
# COMPANION_HUB_BASE_URL=https://your-hub.example
# CI_SERVER_URL=https://your-hub.example
# COMPANION_MEMORY_BASE_URL=https://your-memory.example
# Local Companion Memory dev stack (make dev): https://companion-memory.localhost
# CLOUDFLARE_API_TOKEN is injected from 1Password only for explicit deployment commands.
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128
