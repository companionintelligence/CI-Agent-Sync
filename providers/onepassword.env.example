# Non-secret 1Password CLI settings. Leave OP_ACCOUNT empty to use the
# account most recently authenticated by the 1Password desktop integration.
AGENT_CONFIGS_SECRET_BACKEND=1password
AGENT_CONFIGS_ALLOW_NATIVE_FALLBACK=true
AGENT_CONFIGS_OP_VAULT=Agent Configs
OP_ACCOUNT=
# Set true only when the 1Password desktop integration is enabled.
OP_LOAD_DESKTOP_APP_SETTINGS=true
