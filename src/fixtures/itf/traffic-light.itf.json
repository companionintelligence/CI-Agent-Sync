{
  "#meta": {
    "format": "ITF",
    "format-description": "https://apalache-mc.org/docs/adr/015adr-trace.html",
    "source": "trafficLight.qnt",
    "status": "ok",
    "description": "Hand-written fixture for the src/itf.ts tests, shaped like quint run --mbt output"
  },
  "vars": ["light", "ticks", "seen", "visits", "last", "mbt::actionTaken", "mbt::nondetPicks", "mbt::actionTaken", "mbt::nondetPicks"],
  "states": [
    {
      "#meta": { "index": 0 },
      "light": { "tag": "Red", "value": { "#tup": [] } },
      "ticks": { "#bigint": "0" },
      "seen": { "#set": ["Red"] },
      "visits": { "#map": [] },
      "last": { "#tup": [{ "#bigint": "0" }, "start"] },
      "mbt::actionTaken": "init",
      "mbt::nondetPicks": {
        "next": { "tag": "None", "value": { "#tup": [] } },
        "wait": { "tag": "None", "value": { "#tup": [] } }
      }
    },
    {
      "#meta": { "index": 1 },
      "light": { "tag": "Green", "value": { "#tup": [] } },
      "ticks": { "#bigint": "2" },
      "seen": { "#set": ["Green", "Red"] },
      "visits": { "#map": [["Red", { "#bigint": "1" }]] },
      "last": { "#tup": [{ "#bigint": "1" }, "step"] },
      "mbt::actionTaken": "step",
      "mbt::nondetPicks": {
        "next": { "tag": "Some", "value": "Green" },
        "wait": { "tag": "Some", "value": { "#bigint": "2" } }
      }
    },
    {
      "#meta": { "index": 2 },
      "light": { "tag": "Yellow", "value": { "#tup": [] } },
      "ticks": { "#bigint": "9007199254740993" },
      "seen": { "#set": ["Green", "Red", "Yellow"] },
      "visits": { "#map": [["Red", { "#bigint": "1" }], ["Green", { "#bigint": "1" }]] },
      "last": { "#tup": [{ "#bigint": "2" }, "step"] },
      "mbt::actionTaken": "step",
      "mbt::nondetPicks": {
        "next": { "tag": "Some", "value": "Yellow" },
        "wait": { "tag": "None", "value": { "#tup": [] } }
      }
    }
  ]
}
