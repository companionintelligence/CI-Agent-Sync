version: 1
name: windows-workstation

platform: windows
architecture: x86_64

paths:
  ci_root: "${USERPROFILE}/devel/ci"
  ci_common: "${CI_ROOT}/CI-Common"
  ci_brand_studio: "${CI_ROOT}/CI-Brand-Studio"
  companion_hub: "${CI_ROOT}/CI-Hub"
  companion_memory: "${CI_ROOT}/CI-Memory"
  ci_engineering: "${CI_ROOT}/CI-Engineering"

capabilities:
  docker: true
  node: true
  pnpm: true
  yarn: true
  python: true
  ollama: true
  vscode: true

credential_store:
  type: 1password-cli
  helper: op
  vault_env: AGENT_CONFIGS_OP_VAULT
  fallback: native-client-auth-during-migration-only

# Copy to profiles/machines/local.yaml and adjust locally. Never commit the
# resulting file; it may contain private paths and capability choices.
