#!/usr/bin/env zsh

set -euo pipefail

STORE_ROOT="${0:A:h:h}"
KEYCHAIN_NAMESPACE="agent-configs"
OP_VAULT="${AGENT_CONFIGS_OP_VAULT:-Agent Configs}"
SECRET_BACKEND="${AGENT_CONFIGS_SECRET_BACKEND:-1password}"
ALLOW_NATIVE_FALLBACK="${AGENT_CONFIGS_ALLOW_NATIVE_FALLBACK:-true}"

usage() {
  cat <<'EOF'
agent-store — local agent config and credential helper

Commands:
  inventory                         Show installed agents and config locations
  credentials status                Show which provider credentials exist
  credentials set <provider>        Store one credential in 1Password
  credentials set-native <provider> Store one credential in the native migration store
  credentials delete <provider>     Remove the native migration copy
  credentials op status              Check 1Password CLI, vault, and item access
  credentials op refs                Print safe op:// references (never values)
  credentials op setup               Create or verify the shared 1Password vault
  credentials op import [--remove-native] [PROVIDER...]
                                     Import native credentials without printing them
  with <provider> -- <command...>   Run one command with a secret injected
  audit [agent|all]                 Run safe built-in diagnostics
  snapshot                          Refresh all redacted config snapshots
  vscode audit                      Audit VS Code, extensions, MCP, and plugins
  repos inventory                   Compare the portable repo map to local checkouts
  repos sync [--apply]              Fetch and fast-forward only clean checkouts
  render [--agent NAME]             Generate safe client/workspace artifacts
  sync [--apply] [--target PATH]    Plan or apply reviewed config sync to repos
  fallbacks [CHAIN]                 Show portable fallback chains and models
  doctor [--json]                   Run integrated machine health checks

Providers: anthropic, openai, openrouter, ollama, omlx, companion-hub, companion-hub-qa, companion-hub-inference, companion-hub-fleet-qa, companion-memory, companion-memory-cli, omniroute, android-mcp, cloudflare
EOF
}

normalize_provider() {
  case "$1" in
    claude|anthropic) print -r -- anthropic ;;
    codex|openai) print -r -- openai ;;
    openrouter) print -r -- openrouter ;;
    ollama|ollama-cloud) print -r -- ollama ;;
    omlx|mlx|omlx-local) print -r -- omlx ;;
    companion_hub|companionhub|companion-hub) print -r -- companion-hub ;;
    companion_hub_qa|hub-qa|hub-qa-read|companion-hub-qa) print -r -- companion-hub-qa ;;
    companion_hub_inference|hub-inference|companion-hub-inference) print -r -- companion-hub-inference ;;
    companion_hub_fleet_qa|fleet-qa|hub-fleet-qa|companion-hub-fleet-qa) print -r -- companion-hub-fleet-qa ;;
    companion_memory|companionmemory|ci-memory|memory|companion-memory) print -r -- companion-memory ;;
    companion_memory_cli|companionmemorycli|ci-memory-cli|memory-cli|companion-memory-cli) print -r -- companion-memory-cli ;;
    omniroute|omni-route) print -r -- omniroute ;;
    android|android-mcp|android-remote-control) print -r -- android-mcp ;;
    cloudflare|wrangler) print -r -- cloudflare ;;
    *) print -u2 "Unknown provider: $1"; return 2 ;;
  esac
}

provider_env() {
  case "$1" in
    anthropic) print -r -- ANTHROPIC_API_KEY ;;
    openai) print -r -- OPENAI_API_KEY ;;
    openrouter) print -r -- OPENROUTER_API_KEY ;;
    ollama) print -r -- OLLAMA_API_KEY ;;
    omlx|mlx|omlx-local) print -r -- OMLX_API_KEY ;;
    companion-hub) print -r -- COMPANION_HUB_API_KEY ;;
    companion-hub-qa) print -r -- COMPANION_HUB_QA_API_KEY ;;
    companion-hub-inference) print -r -- COMPANION_HUB_INFERENCE_API_KEY ;;
    companion-hub-fleet-qa) print -r -- FLEET_HUB_API_KEYS_JSON ;;
    companion-memory) print -r -- COMPANION_MEMORY_API_KEY ;;
    companion-memory-cli) print -r -- CI_API_KEY ;;
    omniroute) print -r -- OMNIROUTE_API_KEY ;;
    android-mcp) print -r -- ANDROID_MCP_TOKEN ;;
    cloudflare) print -r -- CLOUDFLARE_API_TOKEN ;;
  esac
}

provider_env_aliases() {
  case "$1" in
    omlx|mlx|omlx-local)
      print -r -- OMLX_API_KEY
      print -r -- OPENAI_API_KEY
      ;;
    companion-hub)
      print -r -- COMPANION_HUB_API_KEY
      print -r -- CI_SERVER_TOKEN
      ;;
    companion-hub-qa) print -r -- COMPANION_HUB_QA_API_KEY ;;
    companion-hub-inference) print -r -- COMPANION_HUB_INFERENCE_API_KEY ;;
    companion-hub-fleet-qa) print -r -- FLEET_HUB_API_KEYS_JSON ;;
    companion-memory)
      print -r -- COMPANION_MEMORY_API_KEY
      print -r -- CI_API_KEY
      print -r -- CI_SERVER_API_KEY
      ;;
    companion-memory-cli)
      print -r -- CI_API_KEY
      print -r -- CI_SERVER_API_KEY
      ;;
    *) print -r -- "$(provider_env "$1")" ;;
  esac
}

service_name() {
  print -r -- "$KEYCHAIN_NAMESPACE/$(normalize_provider "$1")"
}

has_secret() {
  secret_lookup "$1" >/dev/null 2>&1
}

native_secret_lookup() {
  case "$(uname -s)" in
    Darwin)
      security find-generic-password -a "$USER" -s "$(service_name "$1")" -w 2>/dev/null
      ;;
    Linux)
      command -v secret-tool >/dev/null 2>&1 || return 2
      secret-tool lookup service "$(service_name "$1")" account "$USER"
      ;;
    *) return 2 ;;
  esac
}

op_cli_available() {
  command -v "${AGENT_CONFIGS_OP_BINARY:-op}" >/dev/null 2>&1
}

op_session_available() {
  op_cli_available || return 1
  ruby -rtimeout -ropen3 -e '
    pid = nil
    begin
      pid = Process.spawn(*ARGV, in: File::NULL, out: File::NULL, err: File::NULL, pgroup: true)
      _pid, status = Timeout.timeout(30) { Process.waitpid2(pid) }
      exit status.success? ? 0 : 1
    rescue StandardError
      Process.kill("TERM", -pid) rescue Process.kill("TERM", pid) rescue nil if pid
      Process.kill("KILL", -pid) rescue Process.kill("KILL", pid) rescue nil if pid
      exit 1
    end
  ' "${AGENT_CONFIGS_OP_BINARY:-op}" vault list --format=json >/dev/null 2>&1
}

op_provider_item() {
  print -r -- "agent-configs-$(normalize_provider "$1")"
}

op_reference() {
  print -r -- "op://${OP_VAULT}/$(op_provider_item "$1")/credential"
}

op_secret_lookup() {
  op_session_available || return 2
  ruby -rtimeout -ropen3 -e '
    pid = nil
    output_reader = output_writer = error_reader = error_writer = nil
    begin
      output_reader, output_writer = IO.pipe
      error_reader, error_writer = IO.pipe
      pid = Process.spawn(*ARGV, in: File::NULL, out: output_writer, err: error_writer, pgroup: true)
      output_writer.close
      error_writer.close
      _pid, status = Timeout.timeout(30) { Process.waitpid2(pid) }
      print output_reader.read if status.success?
      exit status.success? ? 0 : 1
    rescue StandardError
      Process.kill("TERM", -pid) rescue Process.kill("TERM", pid) rescue nil if pid
      Process.kill("KILL", -pid) rescue Process.kill("KILL", pid) rescue nil if pid
      exit 1
    ensure
      output_reader.close rescue nil if output_reader
      output_writer.close rescue nil if output_writer
      error_reader.close rescue nil if error_reader
      error_writer.close rescue nil if error_writer
    end
  ' "${AGENT_CONFIGS_OP_BINARY:-op}" read --no-newline "$(op_reference "$1")" 2>/dev/null
}

secret_lookup() {
  if [[ "$SECRET_BACKEND" != "native" ]]; then
    op_secret_lookup "$1" && return 0
  fi
  [[ "$ALLOW_NATIVE_FALLBACK" == "true" ]] || return 2
  native_secret_lookup "$1"
}

secret_store_label() {
  case "$(uname -s)" in
    Darwin) print -r -- "macOS Keychain" ;;
    Linux) print -r -- "Linux Secret Service" ;;
    *) print -r -- "native client stores" ;;
  esac
}

credential_source() {
  if op_secret_lookup "$1" >/dev/null 2>&1; then
    print -r -- "1Password"
  elif native_secret_lookup "$1" >/dev/null 2>&1; then
    print -r -- "native migration store"
  else
    print -r -- "not set"
  fi
}

hermes_config_path() {
  if command -v hermes >/dev/null 2>&1; then
    typeset resolved="$(ruby -I"$STORE_ROOT/scripts" -rprocess_helpers -e 'out, _err, status = AgentConfigProcess.capture_with_timeout(["hermes", "config", "path"], 5); print out if status&.success?' 2>/dev/null || true)"
    [[ -n "$resolved" ]] && { print -r -- "$resolved"; return; }
  fi
  print -r -- "$HOME/.hermes/config.yaml"
}

inventory() {
  print "Agent config store: $STORE_ROOT"
  print ""
  typeset hermes_config="$(hermes_config_path)"
  typeset -a rows=(
    "hermes|hermes|$hermes_config"
    "openclaw|openclaw|$HOME/.openclaw/openclaw.json"
    "claude|claude|$HOME/.claude"
    "codex|codex|$HOME/.codex"
    "antigravity|/Applications/Antigravity.app|$HOME/.gemini/antigravity"
    "opencode|opencode|$HOME/.config/opencode/opencode.jsonc"
    "ollama|ollama|$HOME/.ollama"
    "aider-desk|/Applications/aider-desk.app|$HOME/Library/Application Support/aider-desk"
    "pi|/Applications/pi-gui.app|$HOME/.pi"
    "chatgpt|/Applications/ChatGPT.app|$HOME/Library/Application Support/com.openai.chat"
    "vscode|code|$HOME/Library/Application Support/Code/User"
  )
  for row in $rows; do
    IFS='|' read -r name binary config_path <<< "$row"
    if [[ "$binary" == /*.app && -d "$binary" ]]; then
      typeset installed="installed app: $binary"
    elif command_path="$(whence -p "$binary" 2>/dev/null)"; then
      typeset installed="installed: $command_path"
    else
      typeset installed="command not found"
    fi
    [[ -e "$config_path" ]] && typeset config="config: present" || typeset config="config: missing"
    print "  $name — $installed — $config"
    print "    $config_path"
  done
}

credentials_status() {
  print "Provider credentials (1Password first; values never printed):"
  if op_cli_available; then
    if op_session_available; then
      print "  1Password CLI: authenticated; vault: $OP_VAULT"
    else
      print "  1Password CLI: installed but not authenticated"
    fi
  else
    print "  1Password CLI: not installed"
  fi
  for provider in anthropic openai openrouter ollama omlx companion-hub companion-hub-qa companion-hub-inference companion-hub-fleet-qa companion-memory companion-memory-cli omniroute android-mcp cloudflare; do
    typeset source="$(credential_source "$provider")"
    if [[ "$source" != "not set" ]]; then
      print "  ✓ $provider ($(provider_env "$provider")) — $source"
    else
      print "  · $provider ($(provider_env "$provider")) — not set"
    fi
  done
}

credentials_set_native() {
  typeset provider="$(normalize_provider "$1")"
  typeset env_name="$(provider_env "$provider")"
  typeset secret
  print -n "Enter $provider credential for $env_name (hidden): "
  read -r -s secret
  print ""
  [[ -n "$secret" ]] || { print -u2 "Empty credential; nothing saved."; return 2; }
  case "$(uname -s)" in
    Darwin)
      security add-generic-password -a "$USER" -s "$(service_name "$provider")" -w "$secret" -U >/dev/null
      ;;
    Linux)
      command -v secret-tool >/dev/null 2>&1 || { unset secret; print -u2 "Linux Secret Service is unavailable; install secret-tool or use the client's native auth."; return 2; }
      print -rn -- "$secret" | secret-tool store --label="agent-configs/$provider" service "$(service_name "$provider")" account "$USER"
      ;;
    *)
      unset secret
      print -u2 "This platform has no supported shared secret backend; use the client's native auth store."
      return 2
      ;;
  esac
  unset secret
  print "Saved $provider credential to $(secret_store_label)."
}

credentials_set() {
  typeset provider="$(normalize_provider "$1")"
  typeset env_name="$(provider_env "$provider")"
  if [[ "$SECRET_BACKEND" == "native" ]]; then
    credentials_set_native "$provider"
    return
  fi
  typeset secret
  print -n "Enter $provider credential for $env_name (hidden): "
  read -r -s secret
  print ""
  [[ -n "$secret" ]] || { print -u2 "Empty credential; nothing saved."; return 2; }
  op_session_available || {
    unset secret
    print -u2 "1Password is not authenticated. Enable desktop CLI integration and run: op signin"
    print -u2 "For a temporary migration-only copy, use: agent-store credentials set-native $provider"
    return 2
  }
  if ! printf '%s' "$secret" | ruby "$STORE_ROOT/scripts/onepassword.rb" --vault "$OP_VAULT" put "$provider"; then
    unset secret
    return 2
  fi
  unset secret
  print "Saved $provider credential to 1Password vault $OP_VAULT."
}

credentials_delete() {
  typeset provider="$(normalize_provider "$1")"
  case "$(uname -s)" in
    Darwin) security delete-generic-password -a "$USER" -s "$(service_name "$provider")" >/dev/null 2>&1 || true ;;
    Linux) command -v secret-tool >/dev/null 2>&1 && secret-tool clear service "$(service_name "$provider")" account "$USER" >/dev/null 2>&1 || true ;;
  esac
  print "Removed $provider credential if it existed."
}

credentials_op() {
  typeset action="${1:-status}"
  shift || true
  case "$action" in
    status|refs|setup)
      ruby "$STORE_ROOT/scripts/onepassword.rb" --vault "$OP_VAULT" "$action" "$@"
      ;;
    import)
      typeset remove_native=false
      if [[ "${1:-}" == "--remove-native" ]]; then
        remove_native=true
        shift
      fi
      typeset -a selected
      if (( $# > 0 )); then
        selected=("$@")
      else
        selected=(anthropic openai openrouter ollama omlx companion-hub companion-hub-qa companion-hub-inference companion-hub-fleet-qa companion-memory companion-memory-cli omniroute android-mcp cloudflare)
      fi
      op_session_available || { print -u2 "1Password is not authenticated. Enable desktop CLI integration and run: op signin"; return 2; }
      for provider in "${selected[@]}"; do
        provider="$(normalize_provider "$provider")"
        typeset value
        value="$(native_secret_lookup "$provider")" || {
          print "  · $provider — no native migration copy found"
          continue
        }
        if printf '%s' "$value" | ruby "$STORE_ROOT/scripts/onepassword.rb" --vault "$OP_VAULT" put "$provider"; then
          print "  ✓ $provider — imported to 1Password"
          if [[ "$remove_native" == true ]]; then
            credentials_delete "$provider" >/dev/null
            print "    removed native migration copy"
          fi
        else
          print -u2 "  ✗ $provider — import failed"
        fi
        unset value
      done
      ;;
    *)
      print -u2 "Use: agent-store credentials op status|refs|setup|import [--remove-native] [PROVIDER...]"
      return 2
      ;;
  esac
}

vscode_audit() {
  if ! command -v code >/dev/null 2>&1; then
    print "vscode: command not found"
    return 0
  fi

  typeset version="$(code --version 2>/dev/null | sed -n '1p')"
  typeset extension_count="$(code --list-extensions 2>/dev/null | wc -l | tr -d ' ')"
  typeset user_root="$HOME/Library/Application Support/Code/User"
  typeset mcp_file="$user_root/mcp.json"
  typeset settings_file="$user_root/settings.json"
  typeset plugin_file="$HOME/.vscode/agent-plugins/installed.json"

  print "VS Code: $version"
  print "  extensions: $extension_count"
  [[ -f "$settings_file" ]] && print "  user settings: present" || print "  user settings: missing"
  if [[ -f "$mcp_file" ]]; then
    typeset server_count="$(ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); puts j.fetch("servers", {}).length' "$mcp_file" 2>/dev/null || print 0)"
    print "  user MCP config: $server_count server(s)"
    if rg -q '@latest|C:\\\\Users\\\\|"command"[[:space:]]*:[[:space:]]*"other"|CI-Hub|terminal.autoApprove' "$mcp_file" "$settings_file" 2>/dev/null; then
      print "  warning: stale, unpinned, platform-specific, or one-off entries detected"
    else
      print "  MCP/settings drift scan: clean"
    fi
  else
    print "  user MCP config: missing"
  fi
  if [[ -f "$plugin_file" ]]; then
    typeset plugin_count="$(ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); puts Array(j["installed"]).length' "$plugin_file" 2>/dev/null || print 0)"
    print "  agent plugins: $plugin_count recorded"
  else
    print "  agent plugins: no installed.json"
  fi
}

repos_inventory() {
  typeset manifest="$STORE_ROOT/repos/companionintelligence.yaml"
  [[ -f "$manifest" ]] || { print -u2 "Missing repository manifest: $manifest"; return 2; }
  ruby -ryaml -ropen3 -e '
    manifest = YAML.load_file(ARGV[0])
    ci_root = ENV.fetch("CI_ROOT", File.join(Dir.home, "devel", "ci"))
    expand = ->(value) { value.to_s.gsub("${CI_ROOT}", ci_root).gsub("${HOME}", Dir.home) }
    profile_path = File.join(File.dirname(ARGV[0]), "..", "profiles", "machines", "local.yaml")
    profile = File.file?(profile_path) ? YAML.load_file(profile_path) : {}
    paths = profile.fetch("paths", {})
    overrides = {
      "Companion-Hub" => "companion_hub",
      "Companion-Memory" => "companion_memory",
      "CI-Engineering" => "ci_engineering",
    }
    manifest.fetch("repositories").each do |repo|
      override = overrides[repo.fetch("name")]
      root = if override && paths[override]
               expand.call(paths.fetch(override))
             else
               expand.call(repo.fetch("local_path"))
             end
      if Dir.exist?(File.join(root, ".git"))
        _out, _err, status = Open3.capture3("git", "-C", root, "status", "--porcelain")
        branch, _branch_err, _branch_status = Open3.capture3("git", "-C", root, "branch", "--show-current")
        dirty = status.success? && !_out.empty? ? "dirty" : "clean"
        puts "  #{repo.fetch("name")} — present — #{branch.strip.empty? ? "detached" : branch.strip} — #{dirty} — #{root}"
      else
        puts "  #{repo.fetch("name")} — missing — #{root}"
      end
    end
  ' "$manifest"
}

repos_sync() {
  "$STORE_ROOT/scripts/sync-repos.zsh" "$@"
}

render_store() {
  ruby "$STORE_ROOT/scripts/render.rb" "$@"
}

sync_store() {
  ruby "$STORE_ROOT/scripts/sync.rb" "$@"
}

doctor_store() {
  "$STORE_ROOT/bin/agentctl" doctor "$@"
}

fallbacks_store() {
  ruby -ryaml -e '
    data = YAML.safe_load_file(ARGV[0], aliases: false)
    policy = data.fetch("policy")
    providers = data.fetch("providers")
    chains = data.fetch("chains")
    requested = ARGV[1]
    selected = requested && requested != "all" ? { requested => chains.fetch(requested) } : chains
    puts "Fallback policy: local-first, health-gated, max #{policy.fetch("max_attempts_per_request")} attempts"
    puts "External fallback requires explicit enablement; mutations are never retried after they begin."
    selected.each do |name, chain|
      puts ""
      puts name + ": " + chain.fetch("purpose")
      chain.fetch("steps").each_with_index do |step, index|
        provider = providers.fetch(step.fetch("provider"))
        model = provider.fetch("model", "native_default")
        requirement = Array(step["requires"])
        suffix = requirement.empty? ? "" : " [requires: #{requirement.join(", ")}]"
        puts "  #{index + 1}. #{step.fetch("provider")} / #{model}#{suffix}"
      end
    end
  ' "$STORE_ROOT/integrations/providers/fallbacks.yaml" "${1:-all}"
}

with_provider() {
  typeset provider="$(normalize_provider "$1")"
  shift
  [[ "${1:-}" == "--" ]] || { print -u2 "Use: agent-store with <provider> -- <command...>"; return 2; }
  shift
  (( $# > 0 )) || { print -u2 "Missing command."; return 2; }
  typeset value
  value="$(secret_lookup "$provider")" || {
    print -u2 "No $provider credential in 1Password or the allowed migration store. Run: agent-store credentials set $provider"; return 2;
  }
  while IFS= read -r env_name; do
    [[ -n "$env_name" ]] && export "$env_name=$value"
  done <<< "$(provider_env_aliases "$provider")"
  unset value
  exec "$@"
}

redact_output() {
  sed -E 's/((api[_-]?key|token|secret|password|credential|authorization|cookie)[[:space:]]*[:=][[:space:]]*)[^[:space:],}\"]+/\1<redacted>/Ig'
}

audit_one() {
  case "$1" in
    hermes)
      command -v hermes >/dev/null 2>&1 || { print "hermes: not installed"; return 0; }
      hermes doctor 2>&1 | redact_output || true
      ;;
    openclaw)
      [[ -x "$STORE_ROOT/bin/openclaw-runtime" ]] || { print "openclaw runtime selector: not installed"; return 0; }
      if [[ -x "$HOME/.local/bin/openclaw-gateway-with-omlx" ]]; then
        "$HOME/.local/bin/openclaw-gateway-with-omlx" doctor --deep --non-interactive 2>&1 | redact_output || true
      else
        "$STORE_ROOT/bin/openclaw-runtime" doctor --deep --non-interactive 2>&1 | redact_output || true
      fi
      ;;
    claude)
      command -v claude >/dev/null 2>&1 || { print "claude: not installed"; return 0; }
      claude doctor 2>&1 | redact_output || true
      claude plugin validate "$HOME/.claude/skills" 2>&1 | redact_output || true
      ;;
    codex)
      command -v codex >/dev/null 2>&1 || { print "codex: not installed"; return 0; }
      codex doctor --summary 2>&1 | redact_output || true
      ;;
    opencode)
      command -v opencode >/dev/null 2>&1 || { print "opencode: not installed"; return 0; }
      opencode auth list 2>&1 | redact_output || true
      opencode mcp list 2>&1 | redact_output || true
      opencode service status 2>&1 | redact_output || true
      ;;
    ollama)
      command -v ollama >/dev/null 2>&1 || { print "ollama: not installed"; return 0; }
      ollama list 2>&1 | redact_output || true
      ollama ps 2>&1 | redact_output || true
      ;;
    omlx)
      typeset omlx_url="${OMLX_BASE_URL:-http://127.0.0.1:8000/v1}"
      typeset omlx_status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$omlx_url/models" 2>/dev/null || print 000)"
      print "oMLX endpoint: HTTP $omlx_status"
      ;;
    aider-desk)
      [[ -d "/Applications/aider-desk.app" ]] || { print "aider-desk: app not installed"; return 0; }
      /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/aider-desk.app/Contents/Info.plist 2>&1 || true
      "$HOME/Library/Application Support/aider-desk/python-venv/bin/aider" --version 2>&1 | redact_output || true
      ;;
    antigravity)
      [[ -d "/Applications/Antigravity.app" ]] || { print "antigravity: app not installed"; return 0; }
      /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/Antigravity.app/Contents/Info.plist 2>&1 || true
      [[ -s "$HOME/.gemini/antigravity-ide/mcp_config.json" ]] && print "MCP config: non-empty" || print "MCP config: empty"
      ;;
    pi)
      [[ -d "/Applications/pi-gui.app" ]] || { print "pi: app not installed"; return 0; }
      /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/pi-gui.app/Contents/Info.plist 2>&1 || true
      if ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); exit(j.is_a?(Hash) && j.empty? ? 1 : 0)' "$HOME/.pi/agent/models.json" 2>/dev/null; then
        print "model store: non-empty (models.json)"
      else
        print "model store: empty or missing (models.json)"
      fi
      if ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); exit(j.is_a?(Hash) && j.empty? ? 1 : 0)' "$HOME/.pi/agent/auth.json" 2>/dev/null; then
        print "auth store: non-empty"
      else
        print "auth store: empty"
      fi
      ;;
    chatgpt)
      [[ -d "/Applications/ChatGPT.app" ]] || { print "chatgpt: app not installed"; return 0; }
      /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/ChatGPT.app/Contents/Info.plist 2>&1 || true
      print "hosted account state: native to ChatGPT; portable provider injection is not supported by the desktop client"
      ;;
    vscode) vscode_audit ;;
    *) print -u2 "Unknown audit target: $1"; return 2 ;;
  esac
}

snapshot() {
  mkdir -p "$STORE_ROOT/agents/hermes" "$STORE_ROOT/agents/openclaw" "$STORE_ROOT/agents/vscode"
  typeset hermes_config="$(hermes_config_path)"
  [[ -f "$hermes_config" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$hermes_config" "$STORE_ROOT/agents/hermes/current.redacted.yaml"
  [[ -f "$HOME/.openclaw/openclaw.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.openclaw/openclaw.json" "$STORE_ROOT/agents/openclaw/current.redacted.json"
  [[ -f "$HOME/.claude/settings.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.claude/settings.json" "$STORE_ROOT/agents/claude/settings.redacted.json"
  # Claude's root file contains project/session metadata as well as MCP state;
  # keep it out of the store. The legacy nested file is safe to snapshot when
  # present, while the reviewed MCP inventory lives in agents/claude/mcp.redacted.yaml.
  if [[ -f "$HOME/.claude/.claude.json" ]]; then
    ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.claude/.claude.json" "$STORE_ROOT/agents/claude/claude.redacted.json"
  fi
  [[ -f "$HOME/.codex/config.toml" ]] && ruby "$STORE_ROOT/scripts/redact-text.rb" "$HOME/.codex/config.toml" "$STORE_ROOT/agents/codex/config.redacted.toml"
  [[ -f "$HOME/.config/opencode/opencode.jsonc" ]] && ruby "$STORE_ROOT/scripts/redact-text.rb" "$HOME/.config/opencode/opencode.jsonc" "$STORE_ROOT/agents/opencode/opencode.redacted.jsonc"
  [[ -f "$HOME/Library/Application Support/opencode/opencode.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/Library/Application Support/opencode/opencode.json" "$STORE_ROOT/agents/opencode/desktop-current.redacted.json"
  [[ -f "$HOME/Library/Application Support/aider-desk/config.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/Library/Application Support/aider-desk/config.json" "$STORE_ROOT/agents/aider-desk/config.redacted.json"
  [[ -f "$HOME/Library/Application Support/aider-desk/mcp-servers.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/Library/Application Support/aider-desk/mcp-servers.json" "$STORE_ROOT/agents/aider-desk/mcp-servers.redacted.json"
  [[ -f "$HOME/.gemini/antigravity-ide/mcp_config.json" ]] && ruby "$STORE_ROOT/scripts/redact-text.rb" "$HOME/.gemini/antigravity-ide/mcp_config.json" "$STORE_ROOT/agents/antigravity/mcp_config.redacted.jsonc"
  [[ -f "$HOME/.pi/agent/models.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.pi/agent/models.json" "$STORE_ROOT/agents/pi/models.redacted.json"
  [[ -f "$HOME/.pi/agent/models-store.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.pi/agent/models-store.json" "$STORE_ROOT/agents/pi/models-store.redacted.json"
  [[ -f "$HOME/Library/Application Support/Code/User/settings.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/Library/Application Support/Code/User/settings.json" "$STORE_ROOT/agents/vscode/settings.redacted.json"
  [[ -f "$HOME/Library/Application Support/Code/User/mcp.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/Library/Application Support/Code/User/mcp.json" "$STORE_ROOT/agents/vscode/mcp.redacted.json"
  [[ -f "$HOME/.vscode/agent-plugins/installed.json" ]] && ruby "$STORE_ROOT/scripts/redact-config.rb" "$HOME/.vscode/agent-plugins/installed.json" "$STORE_ROOT/agents/vscode/agent-plugins.redacted.json"
  if command -v code >/dev/null 2>&1; then
    code --list-extensions --show-versions 2>/dev/null > "$STORE_ROOT/agents/vscode/extensions.txt" || true
  fi
  print "Wrote redacted snapshots under agents/."
}

case "${1:-}" in
  inventory) inventory ;;
  credentials)
    case "${2:-}" in
      status) credentials_status ;;
      set) credentials_set "${3:?provider required}" ;;
      set-native) credentials_set_native "${3:?provider required}" ;;
      delete) credentials_delete "${3:?provider required}" ;;
      op) credentials_op "${@:3}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  with) with_provider "${2:?provider required}" "${@:3}" ;;
  audit)
    case "${2:-all}" in
      hermes|openclaw|claude|codex|opencode|ollama|omlx|aider-desk|antigravity|pi|chatgpt|vscode) audit_one "$2" ;;
      all)
        for agent in hermes openclaw claude codex opencode ollama omlx aider-desk antigravity pi chatgpt vscode; do
          print "\n===== $agent ====="
          if ! audit_one "$agent"; then
            print "audit failed: $agent"
          fi
        done
        ;;
      *) usage; exit 2 ;;
    esac
    ;;
  snapshot) snapshot ;;
  vscode)
    case "${2:-audit}" in
      audit) vscode_audit ;;
      *) usage; exit 2 ;;
    esac
    ;;
  repos)
    case "${2:-inventory}" in
      inventory) repos_inventory ;;
      sync) repos_sync "${@:3}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  render) render_store "${@:2}" ;;
  sync) sync_store "${@:2}" ;;
  fallbacks) fallbacks_store "${2:-all}" ;;
  doctor) doctor_store "${@:2}" ;;
  *) usage; exit 2 ;;
esac
