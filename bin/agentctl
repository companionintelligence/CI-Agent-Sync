#!/usr/bin/env ruby

# Stable, portable entry point for this repository. Keep orchestration here
# and leave provider-specific behavior in the existing scripts.
root = File.expand_path("..", __dir__)
store = File.join(root, "bin", "agent-store")

def usage
  puts <<~USAGE
    agentctl — portable agent control plane

    Usage:
      agentctl inventory
      agentctl doctor [--json] [--strict]
      agentctl health [--json] [--strict]
      agentctl test [--json] [--live-local]
      agentctl conformance [--json]
      agentctl readiness [--json] [--strict] [--from-1password] [--deploy]
      agentctl report [--json] [--from-1password] [--deploy] [--force] [--output PATH]
      agentctl ledger plan|approve|complete|cancel|list ...
      agentctl profile list|show NAME [--json]
      agentctl backup [--dry-run] [--output PATH]
      agentctl repair openclaw
      agentctl render [options]
      agentctl sync [options]
      agentctl install [--apply] [--clone-reviewed-repos]
      agentctl credentials ...
      agentctl audit ...
      agentctl fallbacks [CHAIN]
      agentctl hub smoke [--json] [--strict]
      agentctl memory smoke [--json] [--strict]
      agentctl fleet smoke [--json] [--strict] [--include-candidates]
      agentctl deploy doctor [--json] [--strict] [--from-1password] [--fleet]

    Credential values stay in 1Password or client-native OAuth stores. This
    command never prints credential values.
  USAGE
end

command = ARGV.shift
case command
when nil, "help", "--help", "-h"
  usage
when "inventory", "doctor", "credentials", "audit", "fallbacks", "render", "sync", "vscode", "repos"
  exec store, command, *ARGV
when "health"
  exec RbConfig.ruby, File.join(root, "scripts", "doctor.rb"), *ARGV
when "test"
  exec RbConfig.ruby, File.join(root, "scripts", "test.rb"), *ARGV
when "conformance"
  exec RbConfig.ruby, File.join(root, "scripts", "conformance.rb"), *ARGV
when "readiness"
  exec RbConfig.ruby, File.join(root, "scripts", "readiness.rb"), *ARGV
when "report", "export-report"
  exec RbConfig.ruby, File.join(root, "scripts", "export-report.rb"), *ARGV
when "ledger"
  exec RbConfig.ruby, File.join(root, "scripts", "action-ledger.rb"), *ARGV
when "profile", "profiles"
  exec RbConfig.ruby, File.join(root, "scripts", "profile.rb"), *ARGV
when "openclaw"
  exec File.join(root, "bin", "openclaw-runtime"), *ARGV
when "hub", "operator"
  exec RbConfig.ruby, File.join(root, "scripts", "hub-control-room.rb"), *ARGV
when "memory"
  target = ARGV.shift
  if target == "smoke"
    exec RbConfig.ruby, File.join(root, "scripts", "memory-control-room.rb"), *ARGV
  end
  warn "Supported memory target: smoke"
  exit 2
when "fleet"
  target = ARGV.shift
  if target == "smoke"
    exec RbConfig.ruby, File.join(root, "scripts", "hub-fleet-smoke.rb"), *ARGV
  end
  warn "Supported fleet target: smoke"
  exit 2
when "deploy"
  target = ARGV.shift
  if target == "doctor"
    exec RbConfig.ruby, File.join(root, "scripts", "deploy-doctor.rb"), *ARGV
  end
  warn "Supported deploy target: doctor"
  exit 2
when "backup"
  exec RbConfig.ruby, File.join(root, "scripts", "backup.rb"), *ARGV
when "repair"
  target = ARGV.shift
  if target == "openclaw"
    exec RbConfig.ruby, File.join(root, "scripts", "repair-openclaw.rb"), *ARGV
  end
  warn "Supported repair target: openclaw"
  exit 2
when "install", "bootstrap"
  exec "zsh", File.join(root, "scripts", "bootstrap-machine.zsh"), *ARGV
else
  warn "Unknown agentctl command: #{command}"
  usage
  exit 2
end
